# ---------------------------------------------------------------------------
# RMS environment configuration
# Copy this file to .env and edit the values.
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database --------------------------------------------------------------
# Leave as sqlite (default, zero setup) or set DB_ENGINE=mysql
DB_ENGINE=sqlite
# DB_ENGINE=mysql
# DB_NAME=rms
# DB_USER=root
# DB_PASSWORD=root
# DB_HOST=localhost
# DB_PORT=3306

# --- Email -----------------------------------------------------------------
# Console backend (default) prints emails to the terminal in development.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For real delivery use:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Optional AI (Google Gemini) -------------------------------------------
# Leave blank to use the built-in offline analyser.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_FALLBACK_ENABLED=True

# --- Uploads ---------------------------------------------------------------
MAX_RESUME_UPLOAD_SIZE=8388608
